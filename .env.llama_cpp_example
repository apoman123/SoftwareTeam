# ─── LLM provider ────────────────────────────────────────────────────────────
# Which backend powers every character: ollama | openai | anthropic | google | llama_cpp
# Using llama.cpp via its OpenAI-compatible HTTP server (ggufs/serve-llama.sh) so the
# model runs on the GPU. Start the server first, then run the team.
SWTEAM_LLM_PROVIDER=openai

# Per-role models. The "coder" model (Tech Lead + Software Engineer) needs strong code +
# tool calling; the "narrative" model handles PM / UX / QA-planning / DevOps prose.
# If unset, sensible defaults are chosen per provider (see config.py). Set both to the
# same value to run everything on one model.
# SWTEAM_CODER_MODEL=
# SWTEAM_NARRATIVE_MODEL=

# Generation temperature (all providers)
SWTEAM_TEMPERATURE=0.2

# ─── Provider: Ollama (local) ────────────────────────────────────────────────
# OLLAMA_HOST=http://localhost:11434
# Defaults: coder=qwen2.5-coder:7b  narrative=llama3.1:8b

# ─── Provider: OpenAI (or any OpenAI-compatible endpoint) ────────────────────
# Install: uv sync --extra openai
# Pointed at the local llama.cpp server (ggufs/serve-llama.sh). The key can be any
# non-empty value; the base URL is the llama-server's OpenAI endpoint.
OPENAI_API_KEY=sk-local
OPENAI_BASE_URL=http://127.0.0.1:8090/v1
# Defaults: coder=gpt-4o  narrative=gpt-4o-mini

# ─── Provider: Anthropic Claude ──────────────────────────────────────────────
# Install: uv sync --extra anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Defaults: coder=claude-opus-4-8  narrative=claude-sonnet-4-6
# (Opus 4.7+ ignore SWTEAM_TEMPERATURE — they no longer accept a temperature param.)

# ─── Provider: Google Gemini (google-genai) ──────────────────────────────────
# Install: uv sync --extra google
# GOOGLE_API_KEY=...               # GEMINI_API_KEY is also accepted
# Defaults: coder=gemini-1.5-pro  narrative=gemini-1.5-flash

# Model names sent to the server: must match the --alias in ggufs/serve-llama.sh.
SWTEAM_CODER_MODEL=Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-Q4_K_M
SWTEAM_NARRATIVE_MODEL=Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-Q4_K_M

# ─── Provider: llama.cpp in-process (local .gguf, no server) ──────────────────
# Alternative to the above: SWTEAM_LLM_PROVIDER=llama_cpp loads the GGUF directly via
# llama-cpp-python (install: uv sync --extra llama-cpp) — needs a CUDA-built wheel for
# GPU. With these models (~21GB) and 15GB RAM, prefer the GPU server path above.
# SWTEAM_CODER_MODEL=/home/apoman123/SoftwareTeam/ggufs/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf
# SWTEAM_NARRATIVE_MODEL=/home/apoman123/SoftwareTeam/ggufs/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf

# ─── Internet search (latest info for every character) ───────────────────────
# Provider: duckduckgo (keyless, default) | tavily | none
# Install: uv sync --extra search        (tavily: uv sync --extra tavily)
SWTEAM_SEARCH_PROVIDER=duckduckgo
SWTEAM_SEARCH_MAX_RESULTS=10
# TAVILY_API_KEY=tvly-...

# ─── Loop caps (prevent infinite review / bug-fix loops) ─────────────────────
SWTEAM_MAX_REVIEW_ITERS=10
SWTEAM_MAX_FIX_ITERS=10
