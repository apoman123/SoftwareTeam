# Ollama connection
OLLAMA_HOST=http://localhost:11434

# Per-role models. "coder" model needs to be good at code + tool calling.
# "narrative" model is used by PM / UX / QA-planning / DevOps narrative tasks.
SWTEAM_CODER_MODEL=qwen2.5-coder:7b
SWTEAM_NARRATIVE_MODEL=llama3.1:8b

# Set both to the same model to run everything on a single model (saves RAM/VRAM):
# SWTEAM_CODER_MODEL=qwen2.5-coder:7b
# SWTEAM_NARRATIVE_MODEL=qwen2.5-coder:7b

# Generation temperature
SWTEAM_TEMPERATURE=0.2

# Loop caps (prevent infinite review / bug-fix loops)
SWTEAM_MAX_REVIEW_ITERS=2
SWTEAM_MAX_FIX_ITERS=2
